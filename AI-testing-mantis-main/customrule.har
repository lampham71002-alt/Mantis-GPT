            "mimeType": "application/json",
            "compression": 8484,
            "text": "{\"data\":[{\"id\":\"1097\",\"title\":\"Call Back Service Last Stop\",\"description\":\"All Call Back Service jobs must be scheduled as the final stop on a technician's route.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T12:23:38+00:00\",\"updated_date\":\"2026-10-02T12:23:38+00:00\"},{\"id\":\"1055\",\"title\":\"Call Back Service Mandatory Assignment\",\"description\":\"All Call Back Service jobs must be forcibly assigned to technician Lam 1 as a mandatory requirement.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T08:01:12+00:00\",\"updated_date\":\"2026-10-02T08:01:12+00:00\"},{\"id\":\"961\",\"title\":\"Call Back Service Mandatory Assignment and Lock\",\"description\":\"All Call Back Service jobs must be strictly assigned to technician custom (Lam 1) and locked in place to prevent auto-pilot from making automated schedule changes.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-29T09:46:44+00:00\",\"updated_date\":\"2026-09-29T09:46:44+00:00\"},{\"id\":\"956\",\"title\":\"Call Back Service Mandatory Assignment and Time Window\",\"description\":\"All Call Back Service jobs must be forcibly assigned to technician Lam 1 (custom) and scheduled within a mandatory time window between 8:00 AM and 6:00 PM.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-29T09:32:30+00:00\",\"updated_date\":\"2026-09-29T09:32:30+00:00\"},{\"id\":\"867\",\"title\":\"Call Back Service Mandatory Time Window\",\"description\":\"All Call Back Service jobs must be scheduled between 8:00 AM and 2:00 PM as a mandatory time window requirement.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-28T03:52:19+00:00\",\"updated_date\":\"2026-09-28T03:52:19+00:00\"},{\"id\":\"966\",\"title\":\"Call Back Service Monthly & Morning Window Policy\",\"description\":\"All Call Back Service jobs must be scheduled within their original month and restricted strictly to a morning time window between 9:00 AM and 12:00 PM.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-29T09:54:04+00:00\",\"updated_date\":\"2026-09-29T09:54:04+00:00\"},{\"id\":\"1098\",\"title\":\"Call Back Service Movement Limit\",\"description\":\"Call Back Service jobs cannot be moved or rescheduled more than 2 days from their originally scheduled service date.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T12:24:21+00:00\",\"updated_date\":\"2026-10-02T12:24:21+00:00\"},{\"id\":\"1052\",\"title\":\"Call Back Service Movement Limit\",\"description\":\"Call Back Service jobs cannot be rescheduled or moved by more than 6 days from their original scheduled date.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T07:52:34+00:00\",\"updated_date\":\"2026-10-02T07:52:34+00:00\"},{\"id\":\"1051\",\"title\":\"Call Back Service Movement Limit\",\"description\":\"All Call Back Service jobs are restricted to a maximum movement limit of 5 days from their original date.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T07:51:48+00:00\",\"updated_date\":\"2026-10-02T07:51:48+00:00\"},{\"id\":\"898\",\"title\":\"Call Back Service Priority & Assignment Rule\",\"description\":\"All Call Back Service jobs must be forcibly assigned to technician custom (Lam 1), remain scheduled within their original week, and be positioned as the first stop of the day.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-28T12:15:18+00:00\",\"updated_date\":\"2026-09-28T12:15:18+00:00\"},{\"id\":\"1099\",\"title\":\"Call Back Service Priority & Movement Constraint\",\"description\":\"Call Back Service jobs must be scheduled as the first stop of the day and cannot be moved more than 5 days from their original date.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T12:41:57+00:00\",\"updated_date\":\"2026-10-02T12:41:57+00:00\"},{\"id\":\"1095\",\"title\":\"Call Back Service Priority & Same-Day Lock\",\"description\":\"All Call Back Service stops must remain scheduled on their original service day and be assigned as the technician's first stop.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T11:34:04+00:00\",\"updated_date\":\"2026-10-02T11:34:04+00:00\"},{\"id\":\"1100\",\"title\":\"Call Back Service Route & Weekly Anchor\",\"description\":\"All Call Back Service jobs must be scheduled within the same week and positioned as the last stop on the technician's route.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-02T13:09:49+00:00\",\"updated_date\":\"2026-10-02T13:09:49+00:00\"},{\"id\":\"1005\",\"title\":\"Call Back Service Routing Exclude\",\"description\":\"All Call Back Service jobs must be excluded from automated routing and remain unchanged.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-30T04:59:08+00:00\",\"updated_date\":\"2026-09-30T04:59:08+00:00\"},{\"id\":\"998\",\"title\":\"Call Back Service Routing Policy\",\"description\":\"All Call Back Service jobs must be retained within their original week, scheduled as the last stop of the day, and assigned with a preference for technician custom.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-30T03:52:53+00:00\",\"updated_date\":\"2026-09-30T03:52:53+00:00\"},{\"id\":\"557\",\"title\":\"Call Back Service Routing Protection\",\"description\":\"All Call Back Service jobs must be excluded from automatic routing and kept in their existing schedule positions.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-21T08:49:45+00:00\",\"updated_date\":\"2026-09-21T08:49:45+00:00\"},{\"id\":\"863\",\"title\":\"Call Back Service Same-Day Lock\",\"description\":\"All Call Back Service stops must remain scheduled within their original day.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-28T03:33:59+00:00\",\"updated_date\":\"2026-09-28T03:33:59+00:00\"},{\"id\":\"1000\",\"title\":\"Call Back Service Schedule Lock & Assignment\",\"description\":\"All Call Back Service jobs must remain scheduled within their original week, be locked against automated routing adjustments, and prefer assignment to technician Lam 1.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-30T04:07:16+00:00\",\"updated_date\":\"2026-09-30T04:07:16+00:00\"},{\"id\":\"897\",\"title\":\"Call Back Service Scheduling & Assignment Policy\",\"description\":\"All Call Back Service stops must remain within their original scheduled week, be assigned exclusively to technician Custom (Lam 1), and be scheduled as the first stop of the day.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-28T12:12:48+00:00\",\"updated_date\":\"2026-09-28T12:12:48+00:00\"},{\"id\":\"996\",\"title\":\"Call Back Service Scheduling & Assignment Rule\",\"description\":\"All Call Back Service stops must remain within their original scheduled week, be strictly assigned to Technician: Lam 1 - nickname: custom, and be restricted to moving no more than 1 day from their original service date.\",\"status\":0,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-09-30T03:43:08+00:00\",\"updated_date\":\"2026-09-30T03:43:08+00:00\"}],\"cursor\":\"eyJvZmZzZXQiOjIwfQ==\",\"show_more\":true,\"success\":true,\"message\":[]}"

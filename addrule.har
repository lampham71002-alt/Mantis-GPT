            "text": "{\"data\":{\"id\":\"1231\",\"title\":\"All Jobs Last Stop Policy\",\"description\":\"All jobs and stops must be scheduled as the last stop on a technician's route.\",\"status\":1,\"created_by\":{\"id\":\"84361445\",\"first_name\":\"Lam\",\"last_name\":\"Test\",\"full_name\":\"Lam Test\",\"avatar\":\"https://d2e627ktfmb6xb.cloudfront.net/avatars%2Fstatic%2Favatar_1.jpg\",\"type\":0},\"created_date\":\"2026-10-05T07:10:56+00:00\",\"updated_date\":\"2026-10-05T07:10:56+00:00\",\"conversation_id\":\"f664c244-c705-4941-80c6-fc215a5c6bf7\",\"rule_detail\":{\"case\":{\"text\":\"\"},\"rule\":{\"text\":\"All jobs and stops must be scheduled as the last stop on a technician's route.\"},\"issue\":{\"text\":\"\"},\"conflict_system_rule_keys\":[]},\"executable_logic\":{\"id\":\"rule_1\",\"name\":\"All Jobs Last Stop Policy\",\"rule\":\"All jobs and stops must be scheduled as the last stop on a technician's route.\",\"rules\":[{\"actions\":[{\"params\":[],\"action_type\":\"last_stop\"}],\"targets\":{\"match\":\"all\",\"statuses\":[],\"tech_name\":[],\"service_date\":[],\"customer_tags\":[],\"region_labels\":[],\"service_types\":[],\"customer_names\":[],\"customer_addresses\":[]}}],\"summary\":\"This draft rule automatically sets all assigned jobs and stops as the final stop of the technician's daily schedule.\",\"classify_action\":\"gen_rule\"}},\"success\":true,\"message\":[]}"

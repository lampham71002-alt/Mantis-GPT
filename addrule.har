            "size": 1687,
            "mimeType": "text/event-stream",
            "compression": -25,
            "text": "{\"id\":\"8209108e-0053-4fee-9210-d3df9bafa12e\",\"conversation_id\":\"f664c244-c705-4941-80c6-fc215a5c6bf7\",\"content_parts\":[],\"sender\":{\"name\":\"Help Agent\",\"avatar\":\"https:\\/\\/d2e627ktfmb6xb.cloudfront.net\\/assets\\/images\\/menu-mantis.webp\"},\"error_message\":\"\",\"allow_retry\":false,\"timestamp\":1791184244,\"role\":\"assistant\",\"has_feedback\":false}\n{\"type\":\"ping\",\"value\":1791184244}\n{\"type\":\"text\",\"value\":\"Here is the proposed draft rule for your review:\\n\\n**Rule Details:**\\n* **Target Jobs:** All jobs and stops\\n* **Routing Action:** Set as the last stop\\n\\nPlease review this proposed rule draft and let me know if you would like to make any adjustments or confirm it.\",\"id\":\"3ddbae41-73d2-486d-8161-a3ea8d7741b1\"}\n{\"type\":\"rule_detail\",\"value\":{\"case\":{\"text\":\"\"},\"issue\":{\"text\":\"\"},\"rule\":{\"text\":\"All jobs and stops must be scheduled as the last stop on a technician's route.\"}},\"id\":\"79aa5513-c62c-46b9-8764-f5fc584b76a1\"}\n{\"type\":\"executable_logic\",\"value\":{\"id\":\"rule_1\",\"name\":\"All Jobs Last Stop Policy\",\"rule\":\"All jobs and stops must be scheduled as the last stop on a technician's route.\",\"summary\":\"This draft rule automatically sets all assigned jobs and stops as the final stop of the technician's daily schedule.\",\"rules\":[{\"targets\":{\"match\":\"all\",\"statuses\":[],\"service_types\":[],\"customer_tags\":[],\"region_labels\":[],\"customer_names\":[],\"customer_addresses\":[],\"service_date\":[],\"tech_name\":[]},\"actions\":[{\"action_type\":\"last_stop\",\"params\":[]}]}],\"classify_action\":\"gen_rule\"},\"id\":\"5ed5aea5-ec7d-4909-a193-893bbe7c0a9f\"}\n{\"type\":\"summary\",\"value\":\"This draft rule automatically sets all assigned jobs and stops as the final stop of the technician's daily schedule.\"}\n"

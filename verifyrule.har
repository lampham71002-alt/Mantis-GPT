            "text": "{\"executable_logic\":{\"id\":\"rule_1\",\"name\":\"Universal Morning Arrival Window\",\"rule\":\"All jobs must be scheduled to arrive within a mandatory time window of 8:00 AM to 12:00 PM.\",\"summary\":\"This rule establishes a mandatory morning arrival window from 8:00 AM to 12:00 PM across all service jobs and stops. Enforcing a strict time window ensures technicians arrive during designated morning hours to meet standard customer service commitments.\",\"rules\":[{\"targets\":{\"match\":\"all\",\"statuses\":[],\"service_types\":[],\"customer_tags\":[],\"region_labels\":[],\"customer_names\":[],\"customer_addresses\":[],\"service_date\":[],\"tech_name\":[]},\"actions\":[{\"action_type\":\"time_window\",\"params\":{\"start_sec\":28800,\"end_sec\":43200,\"strict\":true}}]}],\"classify_action\":\"gen_rule\"},\"conversation_id\":\"00650f82-847d-4c7c-b1d6-dd393bff05c5\"}"

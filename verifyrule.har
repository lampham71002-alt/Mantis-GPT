            "mimeType": "text/event-stream",
            "compression": -25,
            "text": "{\"id\":\"4a15030d-fec7-4f69-93c8-acc22bd1a046\",\"conversation_id\":\"00650f82-847d-4c7c-b1d6-dd393bff05c5\",\"content_parts\":[],\"sender\":{\"name\":\"Help Agent\",\"avatar\":\"https:\\/\\/d2e627ktfmb6xb.cloudfront.net\\/assets\\/images\\/menu-mantis.webp\"},\"error_message\":\"\",\"allow_retry\":false,\"timestamp\":1790999069,\"role\":\"assistant\",\"has_feedback\":false}\n{\"type\":\"ping\",\"value\":1790999069}\n{\"type\":\"text\",\"value\":\"Here is the proposed draft rule for your review:\\n\\n**Rule Details:**\\n* **Target Jobs**: All jobs\\/stops\\n* **Time Window**: Mandatory (strict) constraint between 8:00 AM and 12:00 PM\\n\\nPlease review the details above and let me know if you would like to make any adjustments or finalize this rule.\",\"id\":\"287fa262-ca24-4b5c-9db7-2eff6d904726\"}\n{\"type\":\"rule_detail\",\"value\":{\"case\":{\"text\":\"\"},\"issue\":{\"text\":\"\"},\"rule\":{\"text\":\"All jobs must be scheduled to arrive within a mandatory time window of 8:00 AM to 12:00 PM.\"}},\"id\":\"047da85c-04d6-4c61-83cd-b1206c775c0d\"}\n{\"type\":\"executable_logic\",\"value\":{\"id\":\"rule_1\",\"name\":\"Universal Morning Arrival Window\",\"rule\":\"All jobs must be scheduled to arrive within a mandatory time window of 8:00 AM to 12:00 PM.\",\"summary\":\"This rule establishes a mandatory morning arrival window from 8:00 AM to 12:00 PM across all service jobs and stops. Enforcing a strict time window ensures technicians arrive during designated morning hours to meet standard customer service commitments.\",\"rules\":[{\"targets\":{\"match\":\"all\",\"statuses\":[],\"service_types\":[],\"customer_tags\":[],\"region_labels\":[],\"customer_names\":[],\"customer_addresses\":[],\"service_date\":[],\"tech_name\":[]},\"actions\":[{\"action_type\":\"time_window\",\"params\":{\"start_sec\":28800,\"end_sec\":43200,\"strict\":true}}]}],\"classify_action\":\"gen_rule\"},\"id\":\"68d4fca3-7049-46f3-8590-4f732808bc16\"}\n{\"type\":\"summary\",\"value\":\"This rule establishes a mandatory morning arrival window from 8:00 AM to 12:00 PM across all service jobs and stops. Enforcing a strict time window ensures technicians arrive during designated morning hours to meet standard customer service commitments.\"}\n"
          },
